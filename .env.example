# -----------------------------------------------------------------------------
# ANEI local development configuration. Never copy local secrets to production.
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=development-only-secret-change-me-123456789
TRUSTED_ORIGINS=http://localhost:3000
TRUST_PROXY_HEADERS=false
# Optional LAN dev origins, e.g. 192.168.1.241 (no scheme if Next.js docs require host form for your version)
DEV_ALLOWED_ORIGINS=
AUTH_REQUIRE_EMAIL_VERIFICATION=false
ENABLE_GOOGLE_AUTH=false
ENABLE_FLOUCI=false
ENABLE_CLICTOPAY=false
ENABLE_AI=false
ENABLE_WHATSAPP=false
ENABLE_ADMIN_MFA=false
ENABLE_MCP=false

# n8n automation bridge (Phase 10E)
N8N_WEBHOOK_BASE_URL=http://127.0.0.1:5678
ANEI_N8N_DISPATCH_TOKEN=REPLACE_WITH_UNIQUE_DISPATCH_SECRET
N8N_ANEI_SERVICE_TOKEN=REPLACE_WITH_DIFFERENT_SERVICE_TOKEN
N8N_TIMEOUT_MS=8000
AUTOMATION_WATCHDOG_INTERVAL_MS=30000
AUTOMATION_DISPATCH_SLA_MS=300000
AUTOMATION_RUNNING_SLA_MS=1800000
AUTOMATION_WATCHDOG_BATCH_SIZE=50
N8N_ENCRYPTION_KEY=REPLACE_WITH_LONG_RANDOM_STRING

# PostgreSQL
DATABASE_URL=postgresql://anei:anei@localhost:5432/anei
DB_POOL_MAX=20

# Google OAuth + One Tap (enabled only when the flag and both values are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP / Mailpit locally
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ANEI <no-reply@anei.local>

# Redis
REDIS_URL=redis://localhost:6379

# Payments
PAYMENT_ALLOW_MOCK=true
PAYMENT_DEFAULT_PROVIDER=mock
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
FLOUCI_BASE_URL=https://developers.flouci.com
FLOUCI_ACCEPT_CARD=true
CLICKTOPAY_MERCHANT_ID=
CLICKTOPAY_TERMINAL_ID=
CLICKTOPAY_API_URL=
CLICKTOPAY_API_KEY=
CLICKTOPAY_RETURN_URL=http://localhost:3000/fr/paiement/retour

# Media/storage. Production must use private S3-compatible storage.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=false
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
STORAGE_MEDIA_URL_TTL_SECONDS=7200
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# WhatsApp Cloud API (official Meta). Enabled only when ENABLE_WHATSAPP=true and
# all three secrets are set. Tokens/secrets stay in env — never stored in the DB.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_API_BASE_URL=https://graph.facebook.com

# Auto-provision a CRM contact + send a welcome template when a learner
# completes their profile. Requires an APPROVED Meta template named
# WHATSAPP_WELCOME_TEMPLATE_NAME on the ANEI platform organization's account.
ENABLE_WHATSAPP_AUTO_WELCOME=false
WHATSAPP_WELCOME_TEMPLATE_NAME=anei_welcome

# WhatsApp AI auto-reply (FR/MSA/Tunisian dialect). Dev/staging only — the
# production env guard refuses this flag until the reply implementation is
# reviewed and hardened (see src/server/env.ts).
ENABLE_WHATSAPP_AI_REPLIES=false
WHATSAPP_AI_REPLY_MAX_PER_CONTACT_PER_DAY=20

# Public organization information
CONTACT_EMAIL=contact@anei.local
CONTACT_PHONE=
CONTACT_ADDRESS=Tunis, Tunisie
SECURITY_CONTACT_EMAIL=

# Public site content (optional — feature stays hidden until set)
PLATFORM_INTRO_VIDEO_YOUTUBE_ID=
SOCIAL_LINKEDIN_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=

# Operations
LOG_LEVEL=info
SEED_DEMO_DATA=true

# One-time production bootstrap (set only while running npm run db:bootstrap-admin)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
