# SAFE TEMPLATE ONLY — copy values into your secret/deployment platform.
NODE_ENV=production
APP_URL=https://academy.example.tn
BETTER_AUTH_URL=https://academy.example.tn
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_48_PLUS_CHARACTER_SECRET
TRUSTED_ORIGINS=https://academy.example.tn
TRUST_PROXY_HEADERS=true
AUTH_REQUIRE_EMAIL_VERIFICATION=true
ENABLE_GOOGLE_AUTH=false
ENABLE_FLOUCI=false
ENABLE_CLICTOPAY=false
ENABLE_AI=false
ENABLE_ADMIN_MFA=false

DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_DB_HOST:5432/anei
DB_POOL_MAX=10
REDIS_URL=rediss://USER:PASSWORD@PRIVATE_REDIS_HOST:6379

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brevo: create an SMTP key in Brevo, then use your Brevo login email as SMTP_USER.
# SMTP_FROM must be a sender email/domain verified in Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@your-verified-domain.tn
SMTP_PASS=xsmtpsib-REPLACE_WITH_YOUR_BREVO_SMTP_KEY
SMTP_FROM=ANEI <no-reply@your-verified-domain.tn>

PAYMENT_ALLOW_MOCK=false
PAYMENT_DEFAULT_PROVIDER=flouci
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
FLOUCI_BASE_URL=https://developers.flouci.com
FLOUCI_ACCEPT_CARD=true

CLICKTOPAY_MERCHANT_ID=
CLICKTOPAY_TERMINAL_ID=
CLICKTOPAY_API_URL=
CLICKTOPAY_API_KEY=
CLICKTOPAY_RETURN_URL=https://academy.example.tn/fr/paiement/retour

STORAGE_PROVIDER=s3-compatible
STORAGE_BUCKET=anei-private
STORAGE_ENDPOINT=
STORAGE_REGION=eu-west-1
STORAGE_FORCE_PATH_STYLE=false
STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
STORAGE_MEDIA_URL_TTL_SECONDS=7200
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

CONTACT_EMAIL=contact@example.tn
CONTACT_PHONE=
CONTACT_ADDRESS=REPLACE_WITH_APPROVED_ACADEMY_ADDRESS
SECURITY_CONTACT_EMAIL=security@example.tn
LOG_LEVEL=info
SEED_DEMO_DATA=false
