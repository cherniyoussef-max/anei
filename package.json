{
  "name": "anei-academy-platform",
  "version": "3.4.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "ANEI_BUILD_PHASE=1 next build && tsx scripts/prepare-standalone.ts",
    "start": "NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "smtp:verify": "tsx scripts/verify-smtp.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run security:audit && npm run build",
    "db:baseline": "tsx scripts/baseline-migrations.ts",
    "db:bootstrap-admin": "tsx scripts/create-super-admin.ts",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:security": "tsx --test tests/security/**/*.test.ts",
    "test": "npm run test:unit && npm run test:security",
    "security:audit": "tsx scripts/security-audit.ts",
    "verify": "tsx scripts/verify.ts",
    "test:integration": "tsx --conditions=react-server --test tests/integration/**/*.test.ts",
    "worker:outbox": "tsx --conditions=react-server scripts/worker.ts",
    "test:e2e": "playwright test",
    "test:load": "k6 run tests/load/k6-smoke.js",
    "security:sbom": "npm sbom --sbom-format=cyclonedx > sbom.cdx.json",
    "test:e2e:setup": "playwright install chromium",
    "test:e2e:headed": "playwright test --headed",
    "deps:check": "tsx scripts/dependency-doctor.ts",
    "start:local": "tsx scripts/start-local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@aws-sdk/s3-presigned-post": "3.1121.0",
    "@aws-sdk/s3-request-presigner": "3.1121.0",
    "@better-auth/drizzle-adapter": "1.7.2",
    "@modelcontextprotocol/sdk": "1.30.0",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "nodemailer": "9.0.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.2.1",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.23",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.4"
  }
}
